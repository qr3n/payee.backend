# Application Configuration
PROJECT_NAME="FastAPI Service"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# Server / Granian Configuration
PORT=8000
HOST=0.0.0.0
WORKERS=1

# PostgreSQL Database Configuration
# (Use 'localhost' for local development outside Docker; 'postgres' inside Docker)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis Configuration
# (Use 'localhost' for local development outside Docker; 'redis' inside Docker)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5.0

# CORS Settings (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost", "http://app.localhost", "http://api.localhost"]

# Domain & Traefik Routing Configuration
API_HOST=api.localhost
FRONTEND_HOST=localhost
TRAEFIK_DASHBOARD_PORT=8080

# Production ACME (Let's Encrypt SSL/TLS)
ACME_EMAIL=admin@example.com

# Administrative Security & Access Control
ADMIN_API_KEY="super_secret_admin_key_for_backend"
API_KEY="super_secret_admin_key_for_backend"
ADMIN_CHAT_IDS="[123456789]"

# Telegram Bot Configuration (aiogram 3 + aiogram-dialog)
# (Obtain token from @BotFather)
TELEGRAM_BOT_TOKEN="1234567890:mock_token_for_dev_and_tests"
# Bot mode: 'polling' for local development, 'webhook' for production
TELEGRAM_BOT_MODE=polling
TELEGRAM_DROP_PENDING_UPDATES=true
# FastAPI Backend URL used by Bot as Single Source of Truth
# (Use 'http://localhost:8000' outside Docker; 'http://api:8000' inside Docker)
API_BASE_URL="http://localhost:8000"
BOT_HOST=bot.localhost
# Webhook settings (used when TELEGRAM_BOT_MODE=webhook)
TELEGRAM_WEBHOOK_URL="https://bot.example.com/webhook"
TELEGRAM_WEBHOOK_SECRET="generate-a-secure-random-secret-for-webhook"
REDIS_FSM_DB=1

# Telegram MTProto & Client Settings (Optional, defaults from my.telegram.org)
TELEGRAM_DEFAULT_API_ID=2040
TELEGRAM_DEFAULT_API_HASH="b18441a1ff607e10a989891a5462e627"

# Starslly Bot Payment Scenario Settings
STARSLY_BOT_USERNAME="starslly_bot"
STARSLY_CHANNEL_USERNAME="thelab"
STARS_RECIPIENT_USERNAME="@your_username"
STARS_CALCULATION_RATE=1.0

# StarShoppik Bot Payment Scenario Settings
STARSHOPPIK_BOT_USERNAME="StarShoppik_bot"
STARSHOPPIK_CHANNEL_USERNAME="Star_Shopikk"
STARSHOPPIK_START_PARAM="ref1287935345"

# HelperStars Bot Payment Scenario Settings
HELPERSTARS_BOT_USERNAME="HelperStars_Robot"
HELPERSTARS_CHANNEL_USERNAME="HelperStars_Rezerv"
HELPERSTARS_START_PARAM="1287935345"

# Outbound Payment Webhook Settings
# (Optional HMAC-SHA256 signature key for outgoing merchant callbacks)
PAYMENT_WEBHOOK_SECRET="generate-a-secure-secret-for-signing-webhooks"
PAYMENT_WEBHOOK_TIMEOUT_SECONDS=10.0
PAYMENT_WEBHOOK_MAX_RETRIES=3